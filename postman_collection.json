            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newEmail\": \"new-email@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": "{{base_url}}/users/me/email/verify-otp"
          }
        }
      ]
